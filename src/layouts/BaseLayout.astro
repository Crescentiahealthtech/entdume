---
import { clinic } from '../data/clinic';

interface Props {
  title?: string;
  description?: string;
}

const { title = clinic.name + ' | ENT & Head–Neck Care', description = 'Thoughtful specialist care for ear, nose, throat, hearing, voice and balance concerns at Ponnaiah, R.S. Puram, Coimbatore.' } = Astro.props;

const hospitalSchema = {
  '@context': 'https://schema.org',
  '@type': 'Hospital',
  name: clinic.name,
  url: clinic.siteUrl,
  telephone: clinic.primaryPhoneTel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinic.streetAddress,
    addressLocality: clinic.city,
    addressRegion: clinic.region,
    postalCode: clinic.postalCode,
    addressCountry: clinic.country,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'https://schema.org/Monday',
      'https://schema.org/Tuesday',
      'https://schema.org/Wednesday',
      'https://schema.org/Thursday',
      'https://schema.org/Friday',
      'https://schema.org/Saturday',
    ],
    opens: '09:00',
    closes: '20:00',
  }],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#103d38" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={clinic.siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={clinic.siteUrl} />
    <meta property="og:image" content="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=1200&q=85" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(hospitalSchema)} />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
