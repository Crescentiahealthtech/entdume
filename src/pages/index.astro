---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clinic } from '../data/clinic';

const services = [
  {
    number: '01',
    title: 'Ear & hearing',
    description: 'Ear pain, discharge, hearing changes, blocked ears and concerns about hearing aids.',
    tag: 'HEARING HEALTH',
    icon: 'ear',
  },
  {
    number: '02',
    title: 'Nose & sinus',
    description: 'Persistent nasal blockage, sinus pressure, allergies, smell changes and nosebleeds.',
    tag: 'EASIER BREATHING',
    icon: 'nose',
  },
  {
    number: '03',
    title: 'Throat & voice',
    description: 'Sore throat, swallowing discomfort, voice changes and symptoms that keep returning.',
    tag: 'VOICE & SWALLOWING',
    icon: 'voice',
  },
  {
    number: '04',
    title: 'Vertigo & balance',
    description: 'Dizziness, spinning sensations, imbalance and related ear symptoms.',
    tag: 'BALANCE CARE',
    icon: 'balance',
  },
  {
    number: '05',
    title: 'Paediatric ENT',
    description: 'ENT concerns in children, including recurrent ear or throat infections and mouth-breathing.',
    tag: 'CARE FOR CHILDREN',
    icon: 'child',
  },
  {
    number: '06',
    title: 'Head & neck',
    description: 'Assessment of persistent lumps, neck concerns and other head-and-neck symptoms.',
    tag: 'SPECIALIST REVIEW',
    icon: 'head',
  },
];
---
<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="topbar">
    <div class="container topbar-inner">
      <p><span class="status-dot" aria-hidden="true"></span> ENT-led specialist care <span class="topbar-divider">/</span> R.S. Puram, Coimbatore</p>
      <a href={'tel:' + clinic.primaryPhoneTel} aria-label={'Call reception at ' + clinic.primaryPhoneDisplay}>
        Appointments & enquiries <span class="topbar-phone">{clinic.primaryPhoneDisplay}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 2.8h2.7l1.3 3.4-1.8 1.5a12 12 0 0 0 4.6 4.6l1.5-1.8 3.4 1.3v2.7c0 .7-.6 1.3-1.3 1.3A13.8 13.8 0 0 1 4.2 4.1c0-.7.6-1.3 1.3-1.3Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>

  <header class="site-header">
    <div class="container nav-shell">
      <a class="brand" href="#top" aria-label="Ponnaiah Hospital home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M25.4 8.5c-7.1 0-12.7 5.1-12.7 12 0 5.2 2.5 8.2 5.8 10.8 2.3 1.8 3.6 3.7 3.6 6.2 0 2.6 1.5 4.2 3.9 4.2 2.6 0 4.1-2 4.1-4.7 0-4.1-2.1-6.9-5.2-9.3-2.2-1.7-3.7-3.8-3.7-6.7 0-3 2-5.4 5-5.4 2.6 0 4.2 1.6 4.7 4.3.3 1.7 1.5 2.6 3 2.3 1.5-.3 2.2-1.5 1.8-3.4-1-6.2-5.1-10.3-10.3-10.3Z" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M26.1 22.2c-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5 2.5-1.1 2.5-2.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <span class="brand-copy">
          <span class="brand-name">PONNAIAH</span>
          <span class="brand-descriptor">ENT · HEAD & NECK CARE</span>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#specialties">Specialties</a>
        <a href="#approach">Our approach</a>
        <a href="#patient-guide">Patient guide</a>
        <a href="#visit">Find us</a>
      </nav>

      <a class="button button-nav" href={'tel:' + clinic.primaryPhoneTel}>
        <span>Call to book</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">
          <span>Menu</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </summary>
        <nav aria-label="Mobile navigation">
          <a href="#specialties">Specialties</a>
          <a href="#approach">Our approach</a>
          <a href="#patient-guide">Patient guide</a>
          <a href="#visit">Find us</a>
          <a href={'tel:' + clinic.primaryPhoneTel}>Call {clinic.primaryPhoneDisplay}</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    <section class="hero section-wrap" id="top">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> EAR · NOSE · THROAT · HEAD & NECK</p>
          <h1>Care that helps you <em>hear, breathe</em> and feel like yourself.</h1>
          <p class="hero-description">ENT concerns can affect the small things that make every day feel normal. Find a clear place to start, with specialist attention and a plan explained in plain language.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={'tel:' + clinic.primaryPhoneTel}>
              <span>Plan a visit</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="button button-quiet" href="#specialties">Explore ENT care <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof">
            <span class="proof-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3.5 19 6v5.7c0 4.3-2.8 7.1-7 8.8-4.2-1.7-7-4.5-7-8.8V6l7-2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m8.6 11.9 2.2 2.2 4.6-4.7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <p><strong>Listen first. Explain clearly.</strong><span>Care that puts your concerns at the centre.</span></p>
          </div>
        </div>

        <div class="hero-visual" aria-label="A welcoming clinical environment">
          <div class="hero-image-frame">
            <img
              class="hero-image"
              src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=1400&q=88"
              alt="Doctor in a white coat in a calm clinical portrait"
              fetchpriority="high"
              width="1100"
              height="1350"
            />
            <div class="image-wash" aria-hidden="true"></div>
            <div class="image-caption">
              <span class="caption-symbol" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 5c-5 0-9 3.7-9 8.7 0 3.8 1.8 6 4.2 7.9 1.7 1.3 2.6 2.7 2.6 4.4 0 1.9 1.1 3 2.8 3 1.9 0 3-1.4 3-3.4 0-3-1.5-5-3.8-6.8-1.6-1.2-2.7-2.8-2.7-4.9 0-2.2 1.5-3.9 3.7-3.9 1.9 0 3.1 1.2 3.5 3.1" transform="translate(0 -1)" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
              <span><strong>Your concerns, heard.</strong><small>Thoughtful ENT care, from the first conversation.</small></span>
            </div>
          </div>
          <div class="hero-float float-top"><span class="float-dot"></span> SPECIALIST ENT CARE</div>
          <div class="hero-float float-bottom"><span class="float-ring" aria-hidden="true">✳</span><span>Clarity at every step</span></div>
          <div class="hero-orbit orbit-one" aria-hidden="true"></div>
          <div class="hero-orbit orbit-two" aria-hidden="true"></div>
          <span class="hero-index" aria-hidden="true">01 — 06</span>
        </div>
      </div>
      <div class="container hero-bottomline">
        <span>MADE FOR REAL LIFE</span>
        <span class="bottomline-rule"></span>
        <span>EAR · NOSE · THROAT · HEARING · VOICE · BALANCE</span>
      </div>
    </section>

    <section class="specialty-strip" aria-label="Areas of ENT care">
      <div class="container specialty-strip-inner">
        <span class="strip-label">FOCUSED ON WHAT MATTERS</span>
        <span class="strip-item"><span class="strip-mark">01</span> Hearing & ears</span>
        <span class="strip-item"><span class="strip-mark">02</span> Nose & sinus</span>
        <span class="strip-item"><span class="strip-mark">03</span> Voice & throat</span>
        <span class="strip-item"><span class="strip-mark">04</span> Balance & vertigo</span>
      </div>
    </section>

    <section class="section-wrap services-section" id="specialties">
      <div class="container">
        <div class="section-heading services-heading">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> HOW WE CAN HELP</p>
            <h2>Specialist care for the <em>things you notice.</em></h2>
          </div>
          <p class="section-intro">From a blocked nose to changes in hearing or voice, start with the concern that brought you here. Your clinician can help decide what needs attention next.</p>
        </div>

        <div class="service-grid">
          {services.map((service) => (
            <a class="service-card" href="#visit">
              <div class="service-card-top">
                <span class="service-number">{service.number}</span>
                <span class="service-icon" aria-hidden="true">
                  {service.icon === 'ear' && <svg viewBox="0 0 40 40"><path d="M21 7c-7 0-12 5-12 12 0 5 2 7 5 10 2 2 3 4 3 6 0 2 2 3 4 3 3 0 4-2 4-5 0-4-2-6-5-9-2-1-3-3-3-5 0-3 2-5 5-5 2 0 4 2 4 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 19c-2 0-3 2-2 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
                  {service.icon === 'nose' && <svg viewBox="0 0 40 40"><path d="M20 6c-1 7-3 13-6 18-2 3-3 5-1 7 2 2 7 2 10 1 3-1 5-3 4-5-1-2-3-3-4-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 31c2 2 6 2 9 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
                  {service.icon === 'voice' && <svg viewBox="0 0 40 40"><path d="M20 7v12M15 10a5 5 0 0 1 10 0v10a5 5 0 0 1-10 0v-1M10 19v1a10 10 0 0 0 20 0v-1M20 30v5m-6 0h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {service.icon === 'balance' && <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="13" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="20" cy="20" r="5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M20 3v5m0 24v5M3 20h5m24 0h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
                  {service.icon === 'child' && <svg viewBox="0 0 40 40"><circle cx="20" cy="14" r="7" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M7 35c1-8 5-12 13-12s12 4 13 12M17 14h.1m6 0h.1m-4 4c1 1 2 1 3 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>}
                  {service.icon === 'head' && <svg viewBox="0 0 40 40"><path d="M29 30a14 14 0 1 1 4-9M29 30v-7m0 7h-7M19 13v10l6 3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </span>
              </div>
              <p class="service-tag">{service.tag}</p>
              <h3>{service.title}</h3>
              <p class="service-description">{service.description}</p>
              <span class="service-link">Discuss a concern <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </a>
          ))}
        </div>
        <p class="section-footnote"><span aria-hidden="true">✳</span> The right assessment depends on your symptoms and clinical history. Not every service or procedure is suitable for every patient.</p>
      </div>
    </section>

    <section class="approach-section section-wrap" id="approach">
      <div class="container approach-grid">
        <div class="approach-art" aria-hidden="true">
          <div class="approach-art-inner">
            <div class="sound-rings ring-a"></div>
            <div class="sound-rings ring-b"></div>
            <div class="sound-rings ring-c"></div>
            <div class="approach-orb"><svg viewBox="0 0 140 140"><path d="M77 20C49 14 29 35 31 62c1 15 8 24 18 32 8 6 12 14 12 22 0 10 6 16 15 16 10 0 16-8 16-20 0-14-8-24-19-34-8-7-13-13-13-23 0-11 7-19 18-19 9 0 15 6 17 17" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M80 58c-6-1-10 4-10 9 0 4 2 7 5 10" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/></svg></div>
            <span class="art-label art-label-one">LISTEN</span>
            <span class="art-label art-label-two">UNDERSTAND</span>
            <span class="art-label art-label-three">PLAN</span>
          </div>
          <p class="art-caption">Every good plan starts with the person in front of us.</p>
        </div>

        <div class="approach-copy">
          <p class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> THE PONNAIAH APPROACH</p>
          <h2>Medicine is expertise.<br /><em>Care is how it feels.</em></h2>
          <p class="approach-lead">A visit should leave you with more clarity, not more questions. We believe in listening carefully, explaining options and making the next step easier to understand.</p>
          <div class="approach-points">
            <div class="approach-point">
              <span class="point-number">01</span>
              <div><h3>We listen before we lead.</h3><p>Your symptoms, history and priorities help shape the conversation.</p></div>
            </div>
            <div class="approach-point">
              <span class="point-number">02</span>
              <div><h3>We explain the options.</h3><p>Understand what an examination or investigation is for, and what it may tell us.</p></div>
            </div>
            <div class="approach-point">
              <span class="point-number">03</span>
              <div><h3>We agree on next steps.</h3><p>Leave with a clearer idea of follow-up, treatment options or when to seek further help.</p></div>
            </div>
          </div>
          <a class="text-link text-link-light" href="#patient-guide">What to expect at your visit <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section-wrap patient-section" id="patient-guide">
      <div class="container">
        <div class="section-heading patient-heading">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> YOUR VISIT, MADE SIMPLER</p>
            <h2>Know what to expect <em>before you arrive.</em></h2>
          </div>
          <p class="section-intro">A little preparation can make your appointment feel more straightforward. If something is unclear, call reception before travelling.</p>
        </div>

        <div class="patient-grid">
          <article class="patient-card patient-card-main">
            <span class="patient-card-kicker">01 / BEFORE YOUR VISIT</span>
            <div class="patient-illustration" aria-hidden="true"><svg viewBox="0 0 100 100"><rect x="19" y="14" width="62" height="73" rx="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M34 14v-4h32v4M33 37h34M33 50h25M33 63h30M33 75h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="74" cy="72" r="14" fill="var(--mint)"/><path d="m68 72 4 4 8-9" fill="none" stroke="var(--deep)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <h3>Bring the full picture.</h3>
            <p>Keep previous prescriptions, reports, investigation results and a list of current medicines together. Note when symptoms began and what seems to make them better or worse.</p>
            <a href={'tel:' + clinic.primaryPhoneTel} class="text-link">Ask reception a question <span aria-hidden="true">↗</span></a>
          </article>
          <article class="patient-card">
            <span class="patient-card-kicker">02 / AT YOUR APPOINTMENT</span>
            <span class="patient-icon" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M20 5a15 15 0 1 0 15 15M20 11v9l6 4M28 6v9h9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <h3>Take your time.</h3>
            <p>Describe what has changed, how long it has been happening and how it affects daily life. Ask questions if a term or recommendation is unclear.</p>
          </article>
          <article class="patient-card">
            <span class="patient-card-kicker">03 / AFTER THE VISIT</span>
            <span class="patient-icon" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="m7 20 8 8L33 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 7h12M8 13h8M25 31h8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
            <h3>Know the next step.</h3>
            <p>Before leaving, make sure you understand the plan, how to take any prescribed medicine and when to return or seek urgent help.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="fertility-section">
      <div class="container fertility-panel">
        <div class="fertility-mark" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M32 12c-7 0-13 6-13 13 0 6 3 9 7 12 4 3 6 6 6 10 0 5 3 7 7 7s7-3 7-8c0-6-3-10-8-14-3-3-5-6-5-10 0-4 3-7 7-7 4 0 6 2 7 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M16 16c-3 2-5 5-5 9M49 14l4-4m-2 12 5-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
        <div class="fertility-copy">
          <p class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> A SEPARATE CARE PATHWAY</p>
          <h2>Looking for fertility <em>& IVF care?</em></h2>
          <p>Fertility care is personal, and it deserves a clear, dedicated conversation. Contact reception and ask to be guided to the fertility team.</p>
        </div>
        <a class="button button-cream" href={'tel:' + clinic.primaryPhoneTel}>
          <span>Ask about fertility care</span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>

    <section class="visit-section section-wrap" id="visit">
      <div class="container visit-grid">
        <div class="visit-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> FIND YOUR WAY TO US</p>
          <h2>Let’s make your <em>next step clearer.</em></h2>
          <p class="visit-lead">Call ahead to confirm clinic hours, appointment availability and the best time to visit.</p>
          <a class="button button-primary" href={'tel:' + clinic.primaryPhoneTel}>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 2.8h2.7l1.3 3.4-1.8 1.5a12 12 0 0 0 4.6 4.6l1.5-1.8 3.4 1.3v2.7c0 .7-.6 1.3-1.3 1.3A13.8 13.8 0 0 1 4.2 4.1c0-.7.6-1.3 1.3-1.3Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            <span>Call {clinic.primaryPhoneDisplay}</span>
          </a>
          <p class="visit-note">If you are experiencing a medical emergency, seek urgent medical care rather than waiting for an appointment.</p>
        </div>
        <div class="visit-card">
          <div class="visit-card-header">
            <span class="visit-card-icon" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M32 17c0 10-12 18-12 18S8 27 8 17a12 12 0 1 1 24 0Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="20" cy="17" r="4" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span>
            <span class="visit-card-label">VISIT THE HOSPITAL</span>
          </div>
          <h3>Ponnaiah ENT & IVF Super Speciality Hospital</h3>
          <address>{clinic.address}</address>
          <a class="visit-detail" href={'tel:' + clinic.primaryPhoneTel}>
            <span class="detail-icon" aria-hidden="true">↗</span>
            <span><small>PHONE / RECEPTION</small><strong>{clinic.primaryPhoneDisplay}</strong></span>
          </a>
          <a class="visit-detail" href={'tel:' + clinic.alternatePhoneTel}>
            <span class="detail-icon" aria-hidden="true">↗</span>
            <span><small>ALTERNATE CONTACT</small><strong>{clinic.alternatePhoneDisplay}</strong></span>
          </a>
          <div class="visit-detail visit-hours">
            <span class="detail-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span>
            <span><small>LISTED CLINIC HOURS</small><strong>{clinic.hoursDisplay}</strong><em>Please confirm by phone before travelling.</em></span>
          </div>
          <a class="maps-link" href={clinic.mapsUrl} target="_blank" rel="noopener noreferrer">
            Open directions in Google Maps
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14 14 6M7 6h7v7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="faq-section" id="common-questions">
      <div class="container faq-grid">
        <div>
          <p class="eyebrow"><span class="eyebrow-line"></span> GOOD TO KNOW</p>
          <h2>A few useful <em>answers.</em></h2>
          <p class="section-intro">Every patient and symptom is different. These pointers can help you prepare for a conversation with your clinician.</p>
        </div>
        <div class="faq-list">
          <details>
            <summary>When should I book an ENT appointment?<span aria-hidden="true">+</span></summary>
            <p>Consider an assessment for persistent, recurring or concerning ear, nose, throat, hearing, voice or balance symptoms. Sudden hearing loss, breathing difficulty, severe bleeding or other acute severe symptoms need urgent medical assessment.</p>
          </details>
          <details>
            <summary>Should I bring reports from another hospital?<span aria-hidden="true">+</span></summary>
            <p>Yes. Bring previous prescriptions, investigation reports, scans and a current medicine list if you have them. They may help your clinician understand your history.</p>
          </details>
          <details>
            <summary>Can I confirm timings before travelling?<span aria-hidden="true">+</span></summary>
            <p>Yes. Call reception on {clinic.primaryPhoneDisplay} to confirm listed clinic hours and appointment availability before setting off.</p>
          </details>
          <details>
            <summary>Does this website provide a diagnosis?<span aria-hidden="true">+</span></summary>
            <p>No. The information here is general guidance and cannot replace an examination or advice from a qualified clinician who knows your individual history.</p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <div class="footer-brand">
        <a class="brand brand-footer" href="#top" aria-label="Ponnaiah Hospital home">
